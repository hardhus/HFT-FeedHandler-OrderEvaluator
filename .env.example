# Copy to .env.local (git-ignored) and adjust per machine.
# Windows only: path to vivado.bat if not on PATH
VIVADO=D:/AMDDesignTools/2025.2/Vivado/bin/vivado.bat
# Windows only: WSL distro used for Linux recipes
HFT_WSL_DISTRO=Debian
# Optional: absolute path for build outputs (e.g. a WSL-home dir, faster than /mnt/d)
HFT_BUILD_DIR=
