# Copy to .env.local (git-ignored) and adjust per machine.
# Windows only: path to vivado.bat if not on PATH
VIVADO=D:/AMDDesignTools/2025.2/Vivado/bin/vivado.bat
# Windows only: WSL distro used for Linux recipes
HFT_WSL_DISTRO=Debian
# Optional: absolute path for build outputs (e.g. a WSL-home dir, faster than /mnt/d)
HFT_BUILD_DIR=
# Optional: parallel simulator builds/tests (default: CPUs and RAM; 2 under WSL)
HFT_JOBS=
# WSL only: keep the Linux venv off /mnt/<drive> (Windows tools can clash with a shared .venv;
# ext4 is also faster). Absolute WSL path; leave commented out on the Pi / plain Linux.
# UV_PROJECT_ENVIRONMENT=/home/<you>/.cache/hft-feedhandler/venv
